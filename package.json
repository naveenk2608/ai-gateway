{
  "name": "ai-gateway",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "pnpm --filter @ai-gateway/dashboard test:e2e",
    "lint": "eslint .",
    "check:dashboard-data": "tsx scripts/check-dashboard-data.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --workspace-concurrency=1 typecheck",
    "format": "tsx scripts/format.ts --write",
    "format:check": "tsx scripts/format.ts --check",
    "db:migrate": "pnpm --filter @ai-gateway/gateway db:migrate",
    "db:seed": "pnpm --filter @ai-gateway/gateway db:seed",
    "key:generate": "pnpm --silent --filter @ai-gateway/gateway key:generate",
    "mock:serve": "pnpm --filter @ai-gateway/gateway mock:serve",
    "demo": "tsx scripts/demo.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
