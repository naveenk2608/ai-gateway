# Copy to .env for local development (`pnpm dev` loads it if present). Placeholders only:
# never commit real credentials. The values below match the local Compose stack, which uses
# Postgres trust auth on 127.0.0.1, so they contain no password.

# --- gateway and worker ---
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
DATABASE_URL=postgres://gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379
# How long a SIGTERM waits for in-flight requests (gateway) or work (worker) before forcing exit.
SHUTDOWN_TIMEOUT_MS=10000
# Apply pending database migrations at startup (under a Postgres advisory lock, so several
# instances can start at once). `pnpm db:migrate` does the same by hand.
MIGRATE_ON_START=true
# MIGRATIONS_DIR=            # default: db/migrations (the container image sets its own path)

# Usage events: the gateway writes them to a Redis Stream, the worker stores them in Postgres.
EVENTS_STREAM=gw:events:usage
EVENTS_DLQ_STREAM=gw:events:usage:dlq
EVENTS_CONSUMER_GROUP=usage-workers
# Worker: events per transaction, read wait, how long an unacknowledged event waits before it is
# claimed again, deliveries before it goes to the dead-letter stream, and stream trimming.
WORKER_BATCH_SIZE=100
WORKER_BLOCK_MS=2000
WORKER_CLAIM_IDLE_MS=60000
WORKER_MAX_DELIVERIES=5
WORKER_TRIM_INTERVAL_MS=60000

# --- gateway only ---
# 127.0.0.1 by default; the container image sets 0.0.0.0.
HOST=127.0.0.1
PORT=8080
# Per-dependency timeout for GET /ready.
READY_CHECK_TIMEOUT_MS=2000
# Proxies in front of the gateway whose X-Forwarded-For entries are trusted, counted from the
# right (the client IP is the entry before them; used by login limits). 0 uses the TCP peer.
TRUST_PROXY=0
# Run the usage consumer inside the gateway, for hosts with no background workers (Render's
# free plan). Leave false when the worker process runs.
RUN_WORKER_IN_PROCESS=false
# Usage events kept in memory while Redis is down (beyond it they are dropped and counted), and the
# approximate cap on the stream length.
EVENTS_BUFFER_MAX=10000
EVENTS_STREAM_MAXLEN=100000
# Models file mapping logical model names to deployments (default: apps/gateway/config/models.json).
# MODELS_CONFIG_PATH=
# Default server for Ollama deployments that do not set their own baseUrl.
OLLAMA_BASE_URL=http://localhost:11434
# API keys are read from the variable each deployment names in `apiKeyEnv`. Leave unset to keep
# that deployment disabled.
OPENAI_API_KEY=

# Required. Server secret mixed into API-key hashes; at least 32 characters. Generate one with
# `openssl rand -hex 32`. Changing it invalidates every existing API key.
API_KEY_PEPPER=
# How long a verified key is cached per instance: the longest a revoked key can still work.
API_KEY_CACHE_TTL_MS=30000
# How long an old key keeps working after a rotation, unless the rotate call sets its own.
API_KEY_ROTATION_GRACE_SECONDS=86400
# Admin session lifetime, and whether the cookie is HTTPS-only (default: on in production).
SESSION_TTL_SECONDS=43200
# SESSION_COOKIE_SECURE=

# Limits and budgets (M4). Each project and key can have RPM, TPM and concurrency limits, and
# each project a monthly budget; set them with the admin API. When Redis is unreachable, `closed`
# rejects requests that have any limit or budget with 503, `open` admits them unchecked.
LIMITS_FAIL_MODE=closed
# How long a concurrency lease or budget reservation survives without renewal: how soon a crashed
# request's slot and reservation are freed.
LIMITS_LEASE_TTL_MS=30000
# How often expired budget reservations are released and recorded, and prices reloaded.
BUDGET_SWEEP_INTERVAL_MS=15000
PRICES_REFRESH_INTERVAL_MS=60000
# Admin login attempts per minute for one email address, and from one client IP.
LOGIN_ATTEMPTS_PER_MINUTE=10
LOGIN_ATTEMPTS_PER_MINUTE_PER_IP=30

# Optional first-run setup with no shell (e.g. a hosted platform). Each item is created only if
# missing; existing users, passwords and keys are never changed. Generate a key with
# `pnpm key:generate`. For local demo data, `pnpm db:seed` is simpler.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=   # at least 12 characters
# BOOTSTRAP_API_KEY=          # gw_<16 hex>_<64 hex>
# BOOTSTRAP_PROJECT_NAME=Default project

# --- dashboard dev server ---
# Where `pnpm dev` proxies /api requests.
GATEWAY_URL=http://localhost:8080

# --- docker compose host ports (optional) ---
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# GATEWAY_PORT=8080
# DASHBOARD_PORT=3000
