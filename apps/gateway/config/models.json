{
  "deployments": {
    "mock": {
      "provider": "mock",
      "mock": {
        "ttftMs": 200,
        "tokensPerSecond": 40,
        "latencyMs": 300,
        "completionTokens": 24
      }
    },
    "mock-slow": {
      "provider": "mock",
      "timeoutMs": 5000,
      "mock": {
        "latencyMs": 10000,
        "ttftMs": 10000
      }
    },
    "mock-rate-limited": {
      "provider": "mock",
      "mock": {
        "failWith": 429,
        "retryAfterMs": 2000
      }
    },
    "mock-error": {
      "provider": "mock",
      "mock": {
        "failWith": 500
      }
    },
    "mock-flaky": {
      "provider": "mock",
      "mock": {
        "errorRate": 0.3,
        "seed": 42
      }
    },
    "mock-drop": {
      "provider": "mock",
      "mock": {
        "tokensPerSecond": 20,
        "completionTokens": 40,
        "dropAfterTokens": 10
      }
    },
    "ollama-llama3.2": {
      "provider": "ollama",
      "model": "llama3.2:1b"
    },
    "openai-gpt-4o-mini": {
      "provider": "openai-compatible",
      "model": "gpt-4o-mini",
      "baseUrl": "https://api.openai.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY"
    },
    "groq-gpt-oss-20b": {
      "provider": "openai-compatible",
      "model": "openai/gpt-oss-20b",
      "baseUrl": "https://api.groq.com/openai/v1",
      "apiKeyEnv": "GROQ_API_KEY"
    },
    "gemini-3.5-flash-lite": {
      "provider": "openai-compatible",
      "model": "gemini-3.5-flash-lite",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "apiKeyEnv": "GEMINI_API_KEY"
    }
  },
  "models": {
    "mock-1": {
      "deployment": "mock"
    },
    "mock-slow": {
      "deployment": "mock-slow"
    },
    "mock-rate-limited": {
      "deployment": "mock-rate-limited"
    },
    "mock-error": {
      "deployment": "mock-error"
    },
    "mock-flaky": {
      "deployment": "mock-flaky"
    },
    "mock-drop": {
      "deployment": "mock-drop"
    },
    "llama3.2": {
      "deployment": "ollama-llama3.2"
    },
    "gpt-4o-mini": {
      "deployment": "openai-gpt-4o-mini"
    },
    "gpt-oss-20b": {
      "deployment": "groq-gpt-oss-20b"
    },
    "gemini-3.5-flash-lite": {
      "deployment": "gemini-3.5-flash-lite"
    },
    "chat-default": {
      "policy": "priority",
      "targets": [
        {
          "deployment": "groq-gpt-oss-20b"
        },
        {
          "deployment": "gemini-3.5-flash-lite"
        },
        {
          "deployment": "mock"
        }
      ]
    },
    "mock-failover": {
      "policy": "priority",
      "targets": [
        {
          "deployment": "mock-error"
        },
        {
          "deployment": "mock"
        }
      ]
    },
    "mock-balanced": {
      "policy": "weighted",
      "targets": [
        {
          "deployment": "mock",
          "weight": 3
        },
        {
          "deployment": "mock-flaky",
          "weight": 1
        }
      ]
    }
  }
}
