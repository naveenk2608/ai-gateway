{
  "name": "@ai-gateway/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "config"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/migrate.ts",
    "db:seed": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/seed.ts",
    "key:generate": "tsx --conditions=development src/cli/generate-key.ts"
  },
  "dependencies": {
    "@ai-gateway/shared": "workspace:*",
    "@ai-gateway/worker": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/swagger": "9.9.1",
    "@fastify/swagger-ui": "6.1.1",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "kysely": "0.29.6",
    "undici": "7.30.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "openai": "7.30.0",
    "pg": "8.23.1"
  }
}
