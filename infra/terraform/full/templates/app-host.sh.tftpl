#!/bin/bash
# First boot of a ${role} instance (infra/terraform/full): builds the ${role} image from the
# repository at a fixed ref and runs it. Secrets are read from Secrets Manager through the
# instance role and kept only in a root-only env file; logs go to CloudWatch.
set -euo pipefail
exec > >(tee -a /var/log/ai-gateway-setup.log) 2>&1

${docker_setup}

if [ ! -d /opt/ai-gateway ]; then
  git clone --depth 1 --branch "${git_ref}" "${repository_url}" /opt/ai-gateway
fi
docker build --target ${role} --tag ai-gateway-${role} /opt/ai-gateway

secret() {
  aws secretsmanager get-secret-value --region "${region}" --secret-id "$1" \
    --query SecretString --output text
}
db_secret=$(secret "${db_secret_arn}")
db_user=$(jq -r '.username | @uri' <<<"$db_secret")
db_password=$(jq -r '.password | @uri' <<<"$db_secret")

# RDS requires TLS; the container checks the server against Amazon's RDS certificate bundle.
mkdir -p /opt/ai-gateway-certs
curl -fsSL -o /opt/ai-gateway-certs/rds-ca.pem \
  https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem

umask 077
cat > /opt/ai-gateway.env <<ENV
DATABASE_URL=postgres://$${db_user}:$${db_password}@${db_address}:${db_port}/gateway?sslmode=verify-full&sslrootcert=/certs/rds-ca.pem
EVENT_BUS=sqs
SQS_QUEUE_URL=${queue_url}
SQS_DLQ_URL=${dlq_url}
AWS_REGION=${region}
WORKER_MAX_DELIVERIES=${max_deliveries}
WORKER_CLAIM_IDLE_MS=${visibility_ms}
ENV
%{ if role == "gateway" ~}
app_secret=$(secret "${app_secret_arn}")
cat >> /opt/ai-gateway.env <<ENV
REDIS_URL=rediss://:$(jq -r '.redis_auth_token | @uri' <<<"$app_secret")@${redis_address}:6379
API_KEY_PEPPER=$(jq -r .api_key_pepper <<<"$app_secret")
BOOTSTRAP_ADMIN_EMAIL=${admin_email}
BOOTSTRAP_ADMIN_PASSWORD=$(jq -r .bootstrap_admin_password <<<"$app_secret")
GROQ_API_KEY=$(jq -r .groq_api_key <<<"$app_secret")
GEMINI_API_KEY=$(jq -r .gemini_api_key <<<"$app_secret")
TRUST_PROXY=1
SESSION_COOKIE_SECURE=${secure_cookie}
ENV
publish="--publish 8080:8080"
%{ else ~}
cat >> /opt/ai-gateway.env <<ENV
WORKER_BLOCK_MS=20000
ENV
publish=""
%{ endif ~}

instance_id=$(cat /var/lib/cloud/data/instance-id)
docker run --detach --name ai-gateway-${role} --restart unless-stopped \
  --env-file /opt/ai-gateway.env \
  --volume /opt/ai-gateway-certs:/certs:ro \
  --log-driver awslogs \
  --log-opt awslogs-region=${region} \
  --log-opt awslogs-group=${log_group} \
  --log-opt "awslogs-stream=${role}-$${instance_id}" \
  $publish ai-gateway-${role}
