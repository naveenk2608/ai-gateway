#!/bin/bash
# First boot of the demo instance (infra/terraform/demo): Docker, the repository at a fixed ref,
# and the whole stack with Docker Compose. The secrets are generated here and never leave the
# instance; read them through Session Manager (docs/aws-deployment.md). Building the images
# takes several minutes on a small instance.
set -euo pipefail
exec > >(tee -a /var/log/ai-gateway-setup.log) 2>&1

${docker_setup}

if [ ! -d /opt/ai-gateway ]; then
  git clone --depth 1 --branch "${git_ref}" "${repository_url}" /opt/ai-gateway
fi
cd /opt/ai-gateway

if [ ! -f .env ]; then
  umask 077
  cat > .env <<ENV
API_KEY_PEPPER=$(openssl rand -hex 32)
BOOTSTRAP_ADMIN_EMAIL=${admin_email}
BOOTSTRAP_ADMIN_PASSWORD=$(openssl rand -hex 16)
ENV
fi

docker compose --env-file .env \
  -f infra/compose/docker-compose.yml -f infra/compose/aws-demo.yml \
  --profile full up -d --build
